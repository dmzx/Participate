{
    "name": "dmzx/participate",
    "type": "phpbb-extension",
    "description": "This extension let you be part of an activity (topic)",
    "homepage": "https://www.dmzx-web.net",
    "version": "1.0.1",
    "time": "2026-09-07",
    "license": "GPL-2.0-only",
    "authors": [
        {
            "name": "dmzx",
            "email": "info@dmzx-web.net",
            "homepage": "https://www.dmzx-web.net",
            "role": "Extension developer"
        },
        {
            "name": "John Peskens",
            "email": "info@forumhulp.com",
            "homepage": "http://forumhulp.com",
            "role": "Former developer"
        }
    ],
    "require": {
        "php": ">=7.2",
        "composer/installers": "~1.0",
        "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
    },
    "extra": {
        "display-name": "Participate",
        "soft-require": {
            "phpbb/phpbb": ">=3.3.0,<4.0.0@dev"
        },
        "version-check": {
            "host": "www.phpbb.com",
            "directory": "/customise/db/extension/participate",
            "filename": "version_check",
            "ssl": true
        }
    }
}